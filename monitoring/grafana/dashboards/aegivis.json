{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "annotations": {"list": []},
  "description": "Aegivis — AI Agent Security and Observability",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Requests / sec",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(aegivis_requests_total[1m])",
          "legendFormat": "{{provider}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps", "color": {"mode": "palette-classic"}},
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Blocked Requests / sec",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(aegivis_violations_total{action='BLOCK'}[1m])",
          "legendFormat": "{{rule_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps", "color": {"mode": "fixed", "fixedColor": "red"}},
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Active Sessions",
      "type": "stat",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "aegivis_active_sessions",
          "legendFormat": "Sessions",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "thresholds": {
          "mode": "absolute",
          "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 50},
            {"color": "red", "value": 200}
          ]
        }},
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "colorMode": "background"}
    },
    {
      "id": 4,
      "title": "LLM Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, rate(aegivis_llm_latency_ms_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, rate(aegivis_llm_latency_ms_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, rate(aegivis_llm_latency_ms_bucket[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ms"},
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Violations by Rule",
      "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sort_desc(sum by (rule_name, action) (increase(aegivis_violations_total[1h])))",
          "legendFormat": "{{rule_name}} / {{action}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"sortBy": [{"displayName": "Value", "desc": true}]}
    },
    {
      "id": 6,
      "title": "Security Scan Duration",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, rate(aegivis_security_scan_duration_ms_bucket[5m]))",
          "legendFormat": "p95 {{scanner}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []}
    },
    {
      "id": 7,
      "title": "Events Ingested / sec",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(aegivis_events_ingested_total[1m])",
          "legendFormat": "{{event_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "wps"}, "overrides": []}
    },
    {
      "id": 8,
      "title": "Anomalies Detected / min",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(aegivis_anomalies_detected_total[1m]) * 60",
          "legendFormat": "{{rule_id}} {{severity}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "orange"}},
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Security Scans / sec by Scanner",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(aegivis_security_scans_total[1m])",
          "legendFormat": "{{scanner}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 10,
      "title": "Injection Violations / sec (Alert + Block)",
      "description": "Rate of prompt-injection-alert and prompt-injection-block violations. High rate indicates active injection attempts. Use as a proxy for injection score distribution until aegivis_injection_score histogram is exported.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(aegivis_violations_total{rule_name=~\"prompt-injection.*\"}[1m])",
          "legendFormat": "{{rule_name}} / {{action}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {"mode": "palette-classic"},
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byFrameRefID", "options": "A"},
            "properties": [{"id": "custom.fillOpacity", "value": 15}]
          }
        ]
      }
    },
    {
      "id": 11,
      "title": "Event Queue Throughput / sec",
      "description": "Rate of events enqueued by type. Use as a proxy for backend queue depth — sustained high rate with no backend processing indicates queue buildup. For actual Redis queue depth, deploy redis_exporter alongside Redis.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (event_type) (rate(aegivis_events_enqueued_total[1m]))",
          "legendFormat": "{{event_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "wps",
          "color": {"mode": "palette-classic"},
          "custom": {"fillOpacity": 8}
        },
        "overrides": []
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["aegivis", "ai-security", "observability"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Aegivis — AI Security & Observability",
  "uid": "aegivis-main",
  "version": 1
}
