# =============================================================================
# Aegivis — Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider API Keys (fill in only the providers you use)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Azure OpenAI (only if using Azure provider)
# AZURE_OPENAI_API_KEY=

# HuggingFace token — required for gated models (WalledGuard, Prompt-Guard-86M, Prompt-Guard-2-22M).
# Create one at https://huggingface.co/settings/tokens (read-only token is sufficient).
# Also accept each model's license on its HuggingFace page before using it.
HF_TOKEN=

# =============================================================================
# PROXY (port 8080)
# All variables use AEGIVIS_ prefix.
# =============================================================================

# Where the proxy sends captured events (usually the backend container name)
# AEGIVIS_BACKEND_URL=http://backend:8000
# AEGIVIS_BACKEND_API_KEY=dev-proxy-key

# Organization ID stamped on all events (multi-tenant: one proxy per org)
# AEGIVIS_ORG_ID=default-org

# Proxy server bind address / port
# AEGIVIS_HOST=0.0.0.0
# AEGIVIS_PORT=8080

# CORS — comma-separated allowed dashboard origins
# AEGIVIS_CORS_ORIGINS=["http://localhost:5173","https://dashboard.yourcompany.com"]

# -----------------------------------------------------------------------------
# Upstream LLM provider URLs (defaults are the public APIs)
# Override for Azure, local Ollama, or a corporate proxy
# -----------------------------------------------------------------------------
# AEGIVIS_OPENAI_UPSTREAM=https://api.openai.com
# AEGIVIS_ANTHROPIC_UPSTREAM=https://api.anthropic.com
# AEGIVIS_GOOGLE_UPSTREAM=https://generativelanguage.googleapis.com
# AEGIVIS_AZURE_UPSTREAM=https://<resource>.openai.azure.com
# AEGIVIS_OLLAMA_UPSTREAM=http://localhost:11434

# -----------------------------------------------------------------------------
# Agent identity (optional — enforce per-agent API keys)
# -----------------------------------------------------------------------------
# Comma-separated agent_id:key pairs:
# AEGIVIS_AGENT_KEYS=my-agent:aegivis_abc123,other-agent:aegivis_def456
# AEGIVIS_REQUIRE_AGENT_KEY=false    # set true to reject requests without a valid key

# Admin API key (protects /policies/reload, /tool-permissions/reload)
# Leave empty to disable admin auth (dev only)
# AEGIVIS_ADMIN_API_KEY=

# -----------------------------------------------------------------------------
# Transport / reliability
# -----------------------------------------------------------------------------
# AEGIVIS_BATCH_SIZE=10
# AEGIVIS_BATCH_FLUSH_INTERVAL_S=2.0
# AEGIVIS_TRANSPORT_TIMEOUT_S=10.0
# Local SQLite buffer — holds events when backend is unreachable
# AEGIVIS_BUFFER_DB_PATH=aegivis_buffer.db   # set "" to disable
# AEGIVIS_BUFFER_RETRY_INTERVAL_S=30.0
# AEGIVIS_BUFFER_MAX_EVENTS=50000
# Session state persistence across proxy restarts
# AEGIVIS_SESSION_STATE_PATH=aegivis_sessions.json  # set "" for in-memory only

# -----------------------------------------------------------------------------
# Policy engine
# -----------------------------------------------------------------------------
# AEGIVIS_POLICY_YAML=                      # path to custom YAML; empty = bundled default
# AEGIVIS_POLICY_DISABLED_RULES=            # comma-separated rule names to disable
# AEGIVIS_TOOL_PERMISSIONS_YAML=            # path to tool permissions YAML
# AEGIVIS_VIOLATIONS_ENABLED=true

# =============================================================================
# SECURITY FEATURES
# =============================================================================

# -----------------------------------------------------------------------------
# Injection detection thresholds (structural scanner)
# score >= block_threshold → BLOCK; score >= alert_threshold → ALERT
# -----------------------------------------------------------------------------
# AEGIVIS_SECURITY_INJECTION_BLOCK_THRESHOLD=0.80
# AEGIVIS_SECURITY_INJECTION_ALERT_THRESHOLD=0.50

# Credential confidence threshold (matches below this value are ignored)
# AEGIVIS_SECURITY_CREDENTIAL_CONFIDENCE_THRESHOLD=0.40

# Context-aware rolling injection detection (Crescendo / multi-turn attacks)
# AEGIVIS_SECURITY_CONTEXT_INJECTION_WINDOW=5       # turns to average
# AEGIVIS_SECURITY_CONTEXT_INJECTION_ALERT_AVG=0.35
# AEGIVIS_SECURITY_CONTEXT_INJECTION_BLOCK_AVG=0.60

# -----------------------------------------------------------------------------
# Canary token injection (anti-exfiltration, zero FPR)
# -----------------------------------------------------------------------------
# AEGIVIS_SECURITY_CANARY_ENABLED=true

# -----------------------------------------------------------------------------
# Spotlighting (Indirect Prompt Injection defense — Microsoft Research 2024)
# Wraps tool results in randomized delimiters; reduces IPI success >50% → <2%
# -----------------------------------------------------------------------------
# AEGIVIS_SECURITY_SPOTLIGHTING_ENABLED=true

# -----------------------------------------------------------------------------
# Output scanning (post-response: canary, relay patterns, credentials)
# -----------------------------------------------------------------------------
# AEGIVIS_SECURITY_OUTPUT_SCANNING_ENABLED=true

# -----------------------------------------------------------------------------
# Tool output scanning (scan tool return values for injection before re-entry)
# Closes indirect-injection gap (EchoLeak CVE-2025-32711)
# -----------------------------------------------------------------------------
# AEGIVIS_SECURITY_TOOL_OUTPUT_SCANNING_ENABLED=true
# AEGIVIS_SECURITY_TOOL_OUTPUT_MAX_BYTES=8192
# AEGIVIS_SECURITY_TOOL_OUTPUT_ML_SCAN_ENABLED=false  # adds ~50ms per tool call

# -----------------------------------------------------------------------------
# MCP tool definition scanning (name traversal, description injection)
# -----------------------------------------------------------------------------
# AEGIVIS_SECURITY_MCP_SCANNING_ENABLED=true

# -----------------------------------------------------------------------------
# Unicode steganography scanner (hidden injection via invisible chars)
# -----------------------------------------------------------------------------
# AEGIVIS_SECURITY_UNICODE_STEGO_ENABLED=true

# -----------------------------------------------------------------------------
# Document scanning (PDF/DOCX hidden layers, annotations, macros)
# Requires: pip install 'aegivis-proxy[docs]'
# -----------------------------------------------------------------------------
# AEGIVIS_SECURITY_DOCUMENT_SCAN_ENABLED=true

# -----------------------------------------------------------------------------
# Behavioral analytics (Markov + Isolation Forest anomaly detection)
# -----------------------------------------------------------------------------
# AEGIVIS_SECURITY_BEHAVIORAL_ENABLED=true
# AEGIVIS_SECURITY_ISOLATION_FOREST_MIN_SAMPLES=10
# AEGIVIS_SECURITY_ISOLATION_FOREST_CONTAMINATION=0.05
# AEGIVIS_SECURITY_MARKOV_ALERT_THRESHOLD=0.05

# -----------------------------------------------------------------------------
# RCE / SSRF scanners
# -----------------------------------------------------------------------------
# AEGIVIS_SECURITY_RCE_CONFIDENCE_THRESHOLD=0.70
# AEGIVIS_SECURITY_SSRF_ALLOWED_DOMAINS=          # comma-separated; empty = audit only
# AEGIVIS_SECURITY_SSRF_ENABLE_DNS_RESOLUTION=true

# -----------------------------------------------------------------------------
# Data flow taint tracking — Phase 8 (credential-level, near-zero FPR)
# -----------------------------------------------------------------------------
# AEGIVIS_SECURITY_TAINT_TRACKING_ENABLED=true

# -----------------------------------------------------------------------------
# IFC Label System — Phase 11 (deterministic TRUSTED/EXTERNAL label propagation)
# -----------------------------------------------------------------------------
# AEGIVIS_SECURITY_IFC_ENABLED=true
# AEGIVIS_SECURITY_IFC_BLOCK=true    # false = alert only
# AEGIVIS_SECURITY_IFC_EXTRA_SINK_KEYS=  # comma-separated extra privileged sink keys

# -----------------------------------------------------------------------------
# Session PDG — Phase 10 (multi-hop exfil detection, Wang et al. AgentArmor)
# -----------------------------------------------------------------------------
# AEGIVIS_SECURITY_PDG_ENABLED=true
# AEGIVIS_SECURITY_PDG_ACTION=alert   # "alert" or "block"

# -----------------------------------------------------------------------------
# Hard Egress Enforcement — Phase 13 (deterministic allowlist)
# Mode "allowlist": BLOCK tool calls to destinations not in the allowlist
# Mode "audit": log violations only (use during learning period)
# Mode "off": disabled
# Allowlist format: api.openai.com, *.anthropic.com, 10.0.0.0/8, db.internal:5432
# -----------------------------------------------------------------------------
# AEGIVIS_SECURITY_EGRESS_MODE=audit
# AEGIVIS_SECURITY_EGRESS_ALLOWLIST=api.openai.com,*.anthropic.com

# -----------------------------------------------------------------------------
# Capability Manifests — Phase 12 (HMAC-SHA256 signed tool allowlists)
# Must match AEGIVIS_MANIFEST_SIGNING_KEY on the backend.
# Example: AEGIVIS_MANIFEST_SIGNING_KEY=$(openssl rand -hex 32)
# -----------------------------------------------------------------------------
# AEGIVIS_MANIFEST_SIGNING_KEY=
# AEGIVIS_MANIFEST_ENFORCE=true   # false = alert only (rollout mode)
# AEGIVIS_MANIFEST_CACHE_TTL_S=300

# -----------------------------------------------------------------------------
# ML injection classifier — Phase 4
# Requires: pip install 'aegivis-proxy[classifier]' (transformers + torch)
#
# ASYNC mode: runs after forwarding, sets flag for NEXT call (0ms added latency)
# SYNC mode:  runs inline BEFORE forwarding, adds ~50ms (blocks current call)
# Both can be active simultaneously; sync skips async when already flagged.
# -----------------------------------------------------------------------------
# AEGIVIS_ANALYSIS_CLASSIFIER_ENABLED=false       # async mode
# AEGIVIS_ANALYSIS_CLASSIFIER_SYNC_ENABLED=false  # sync mode
# AEGIVIS_ANALYSIS_CLASSIFIER_MODEL=protectai/deberta-v3-base-prompt-injection-v2
# AEGIVIS_ANALYSIS_CLASSIFIER_THRESHOLD=0.85
# Ensemble second classifier (RoBERTa, ~86MB — catches what DeBERTa misses)
# AEGIVIS_ANALYSIS_CLASSIFIER_SECOND_ENABLED=false
# AEGIVIS_ANALYSIS_CLASSIFIER_SECOND_MODEL=meta-llama/Prompt-Guard-86M

# -----------------------------------------------------------------------------
# Human-in-the-Loop (HITL) approvals — Phase 9
# -----------------------------------------------------------------------------
# AEGIVIS_HITL_ENABLED=false
# AEGIVIS_HITL_REQUIRED_TOOLS=bash,exec,shell,http_request   # always require approval
# AEGIVIS_HITL_SCORE_THRESHOLD=0.95   # require approval when enforcement score >= this
# AEGIVIS_HITL_TIMEOUT_SECONDS=300    # seconds to wait before treating as denied
# AEGIVIS_HITL_ON_NETWORK_SINK=true   # require approval for tainted credential → network

# -----------------------------------------------------------------------------
# Trust propagation — Phase 9 (lower threshold for children of compromised sessions)
# -----------------------------------------------------------------------------
# AEGIVIS_TRUST_PROPAGATION_ENABLED=true
# AEGIVIS_TRUST_PROPAGATION_DISCOUNT=0.20

# -----------------------------------------------------------------------------
# Multi-agent spawn chain enforcement — Phase 6
# Set X-Aegivis-Parent-Agent-Id + X-Aegivis-Parent-Session-Id headers when spawning
# -----------------------------------------------------------------------------
# AEGIVIS_MAX_SPAWN_DEPTH=10

# -----------------------------------------------------------------------------
# Tool baseline enforcement
# -----------------------------------------------------------------------------
# AEGIVIS_TOOL_BASELINE_ENABLED=true
# AEGIVIS_TOOL_BASELINE_CACHE_TTL_S=300.0

# -----------------------------------------------------------------------------
# Rate limiting / token budgets
# -----------------------------------------------------------------------------
# AEGIVIS_RATE_LIMIT_MAX_TOKENS_PER_SESSION=0      # 0 = disabled
# AEGIVIS_RATE_LIMIT_MAX_LLM_CALLS_PER_SESSION=0  # 0 = disabled

# -----------------------------------------------------------------------------
# Request body size limit
# -----------------------------------------------------------------------------
# AEGIVIS_MAX_REQUEST_BODY_BYTES=10485760   # 10 MB

# -----------------------------------------------------------------------------
# PII detection
# -----------------------------------------------------------------------------
# AEGIVIS_PII_ENABLED=true
# AEGIVIS_PII_LANGUAGE=en

# -----------------------------------------------------------------------------
# Reasoning trace capture (Anthropic extended thinking)
# -----------------------------------------------------------------------------
# AEGIVIS_REASONING_TRACE_MAX_CHARS=4000

# =============================================================================
# BACKEND (port 8000)
# =============================================================================

# PostgreSQL connection string
# AEGIVIS_DATABASE_URL=postgresql+asyncpg://aegivis:aegivis@postgres:5432/aegivis

# API keys accepted by the backend (JSON array)
# AEGIVIS_API_KEYS=["dev-proxy-key","dev-dashboard-key"]

# Backend CORS
# AEGIVIS_CORS_ORIGINS=["http://localhost:5173","https://dashboard.yourcompany.com"]

# Pagination
# AEGIVIS_DEFAULT_PAGE_SIZE=50
# AEGIVIS_MAX_PAGE_SIZE=200

# Rate limiting (sliding-window counter per API key or client IP)
# AEGIVIS_RATE_LIMIT_ENABLED=true
# AEGIVIS_RATE_LIMIT_PER_MINUTE=300          # read/general endpoints
# AEGIVIS_RATE_LIMIT_INGEST_PER_MINUTE=3000  # POST /v1/events, /v1/violations

# =============================================================================
# ALERTS & NOTIFICATIONS
# =============================================================================

# -----------------------------------------------------------------------------
# Email (SMTP) — BLOCK violations and critical anomalies
# -----------------------------------------------------------------------------
# AEGIVIS_SMTP_HOST=smtp.gmail.com
# AEGIVIS_SMTP_PORT=587
# AEGIVIS_SMTP_USER=your@gmail.com
# AEGIVIS_SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx   # Gmail App Password
# AEGIVIS_SMTP_FROM=alerts@aegivis.local
# AEGIVIS_SMTP_TO=oncall@yourcompany.com

# -----------------------------------------------------------------------------
# Slack webhook
# -----------------------------------------------------------------------------
# AEGIVIS_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# -----------------------------------------------------------------------------
# PagerDuty Events API v2
# -----------------------------------------------------------------------------
# AEGIVIS_PAGERDUTY_ROUTING_KEY=

# -----------------------------------------------------------------------------
# Generic webhook (HMAC-SHA256 signed)
# -----------------------------------------------------------------------------
# AEGIVIS_ALERT_WEBHOOK_URL=
# AEGIVIS_ALERT_WEBHOOK_SECRET=   # optional signing secret

# Alert de-duplication / severity filter
# AEGIVIS_ALERT_COOLDOWN_S=600        # suppress duplicate alerts within N seconds
# AEGIVIS_ALERT_MIN_SEVERITY=MEDIUM   # LOW | MEDIUM | HIGH | CRITICAL

# =============================================================================
# SIEM EXPORT
# =============================================================================

# Splunk HEC
# AEGIVIS_SPLUNK_HEC_URL=https://splunk.yourcompany.com:8088/services/collector
# AEGIVIS_SPLUNK_HEC_TOKEN=
# AEGIVIS_SPLUNK_INDEX=aegivis

# Elasticsearch
# AEGIVIS_ELASTIC_URL=https://elastic.yourcompany.com:9200
# AEGIVIS_ELASTIC_API_KEY=
# AEGIVIS_ELASTIC_INDEX=aegivis

# =============================================================================
# REDIS (optional — enables distributed session state + event streaming)
# Set to a Redis URL to enable RedisSessionTracker + RedisTransport.
# Empty = in-memory sessions + direct HTTP transport (default for single-node).
# Example: redis://redis:6379/0
# =============================================================================
# AEGIVIS_REDIS_URL=

# =============================================================================
# OBSERVABILITY
# =============================================================================

# Prometheus metrics (/metrics endpoint)
# AEGIVIS_METRICS_ENABLED=true

# OpenTelemetry distributed tracing (OTLP/gRPC — Jaeger, Tempo, etc.)
# AEGIVIS_OTEL_ENABLED=false
# AEGIVIS_OTEL_ENDPOINT=http://localhost:4317
# AEGIVIS_OTEL_SERVICE_NAME=aegivis-proxy   # or aegivis-backend

# =============================================================================
# LOGGING
# =============================================================================
# AEGIVIS_LOG_LEVEL=INFO
# AEGIVIS_LOG_REQUEST_BODIES=false   # set true only in dev — logs full request bodies

# Hash chain checkpoint interval (events per session before writing a CHECKPOINT)
# AEGIVIS_CHECKPOINT_INTERVAL=1000
