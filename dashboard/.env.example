VITE_BACKEND_URL=http://localhost:8000
VITE_API_KEY=dev-dashboard-key

# Edition — "community" (default) or "enterprise"
# Enterprise docker-compose.override.yml sets this to "enterprise" automatically.
VITE_EDITION=community
# Override proxy base URL for non-Docker setups (default: /proxy via nginx)
VITE_PROXY_URL=http://localhost:8080
# Override WebSocket alert stream URL (default: derived from window.location)
VITE_WS_URL=ws://localhost:8000/ws/alerts

# Error reporting (production only). JS errors are POSTed to VITE_API_BASE_URL/v1/ingest.
# Set to "false" to disable. All error data stays in your own backend (no external SaaS).
# Alternatively, install @sentry/react and set VITE_SENTRY_DSN to use Sentry instead.
VITE_ERROR_REPORTING=true
